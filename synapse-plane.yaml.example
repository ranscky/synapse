# Synapse Control Plane (v2) Configuration Example
#
# Copy this to synapse-plane.yaml and edit it. Every key can also come from the
# environment: when the matching SYNAPSE_* variable is set to a non-empty
# value it wins over whatever is written below, which is how a real deployment
# injects secrets without storing them on disk.
#
# The plane never logs the value of database-dsn, jwt-secret, admin-token,
# master-key, or stripe-webhook-secret. Startup logs report them as "set" or
# "unset" only, and validation errors name the offending key without echoing it.

# Bind address for the control plane HTTP server. No environment override.
# Must stay loopback (127.0.0.1, localhost, or ::1): the plane refuses to
# start on 0.0.0.0 or any public interface.
listen-addr: "127.0.0.1:9090"

# Postgres connection string used by the v2 plane. Overridden by
# SYNAPSE_DB_DSN. Required: startup is fatal when both this key and the
# environment variable are empty. Secret: never logged.
# DEV PLACEHOLDER -- no database is contacted yet in Phase 1; replace it in
# any real deployment.
database-dsn: "postgres://synapse:synapse@127.0.0.1:5432/synapse?sslmode=disable"

# HMAC signing key for issued JWTs. Overridden by SYNAPSE_JWT_SECRET.
# Required and must be at least 32 characters: startup is fatal otherwise.
# Secret: never logged, never echoed in error messages.
# DEV PLACEHOLDER -- generate a real one with: openssl rand -hex 32
jwt-secret: "dev-only-placeholder-secret-not-for-any-real-deployment"

# Token guarding the plane's admin endpoints, which today means
# POST /v2/tenants. Overridden by SYNAPSE_ADMIN_TOKEN. Enforced: the route is
# checked against this value on every request, and a blank value makes the route
# answer 401 to everyone (the plane warns at startup but still boots).
# The header is the token itself -- an exact match, no "Bearer " prefix.
# Secret: never logged, never echoed in error messages.
# DEV PLACEHOLDER -- replace or blank it in any real deployment.
admin-token: "dev-only-placeholder-admin-token"

# Key used to wrap per-tenant ledger signing secrets before storage. Overridden
# by SYNAPSE_MASTER_KEY. Required since Phase 18: provisioning mints a signing
# secret for every tenant, and that write cannot happen without this key, so the
# plane refuses to boot without one.
#
# It must be exactly 64 hexadecimal characters (32 bytes) -- AES-256's key size
# (tenant.masterKeyFromEnv enforces both the encoding and the length). The value
# below is a shape-correct DEV PLACEHOLDER: replace it in any real deployment,
# and note that a "change-me-..." style placeholder is not hex and will make
# provisioning fail.
# Secret: never logged.
master-key: "1f8b0a4c2d9e73511f8b0a4c2d9e73511f8b0a4c2d9e73511f8b0a4c2d9e7351"

# Startup log verbosity: debug, info, warn, or error (anything else falls back
# to info). No environment override.
log-level: "info"

# Days of ledger history kept available for reporting/archival tooling. The
# ledger table is append-only and is never updated or deleted, so this value
# never triggers data removal. No environment override.
ledger-retention-days: 365

# HTML template GET /v2/compliance/report?format=pdf renders its document from,
# relative to the plane's working directory. Blank means the default below.
#
# It is not a secret and not a requirement: a plane that only ever serves the
# JSON report boots fine without this file, and a PDF request against a missing
# template is a logged 500 rather than a startup failure. The PDF renderer
# itself (wkhtmltopdf, or chromium/google-chrome --headless --print-to-pdf) is
# resolved from PATH at request time; with none installed, ?format=pdf answers
# 503 with the fix in its body. No environment override.
report-template: "ui/plane/compliance-report.html"

# Signing secret of the Stripe webhook endpoint POST /v2/billing/webhook is
# registered as. Overridden by STRIPE_WEBHOOK_SECRET -- note the variable name:
# this is the one key whose environment variable is NOT SYNAPSE_-prefixed, because
# it is the name Stripe's own dashboard hands out.
#
# It is the whole authentication for that route. Stripe cannot hold a Synapse
# token, so no middleware guards the path; the Stripe-Signature header, checked
# against this value, is what proves a delivery is real. Requests that fail the
# check are answered 400 and reach no database.
#
# Leaving it blank is not fatal, and it is not silent either: startup reports the
# key as "unset", and every delivery is then answered 503 without being processed
# -- 503 rather than 400 because Stripe retries a non-2xx for about three days,
# which is the window to configure the secret before the events are dropped.
# Secret: never logged, never echoed in an error, never included in a rejection.
stripe-webhook-secret: ""
