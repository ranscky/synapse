# Build the Synapse v2 control plane. Build context is the repository root:
#   docker build -f deploy/Dockerfile.plane -t synapse-plane .
FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY . .
# CGO_ENABLED=0 is required, not cosmetic: golang:alpine ships no C toolchain
# ("additional related tools (such as git, gcc, or bash) are not included in
# Alpine-based images"), and ./cmd/plane pulls cgo-requiring standard packages
# when cgo is on (net, via net/http). Building with CGO_ENABLED=1 there fails
# with: cgo: C compiler "gcc" not found, reported against package runtime/cgo.
# The plane itself has no cgo dependency. Since Phase 8 its import graph reaches
# internal/store (the sync endpoint writes through the tenant-scoped PostgreSQL
# store and its sanitization pipeline), and go-sqlite3 ships a !cgo stub that
# compiles under this flag; no SQLite database is ever opened by this binary --
# the control plane talks to PostgreSQL only -- and onnxruntime still lives in
# internal/embedder, which ./cmd/plane never imports. The result is a static
# binary.
ENV CGO_ENABLED=0
RUN go build -o /bin/plane ./cmd/plane

FROM alpine:3.19
COPY --from=builder /bin/plane /bin/plane
EXPOSE 9090
ENTRYPOINT ["/bin/plane"]
