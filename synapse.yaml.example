# Synapse Context Compiler Configuration Example
# Copy this to synapse.yaml and modify as needed

# Required: Upstream model server URL (must start with http:// or https://)
upstream-url: "http://localhost:11434"

# Listen address for the proxy (must default to 127.0.0.1 for security)
listen-addr: "127.0.0.1:8080"

# Maximum tokens in compiled context
token-budget: 3000

# Embedding backend: "onnx" or "openai"
embedder-type: "onnx"

# Path to the ONNX model file (only used when embedder-type is "onnx")
model-path: "models/all-MiniLM-L6-v2/model.onnx"

# SQLite database path. Leave blank to use the OS-standard data directory
# (~/.local/share/synapse on Linux, ~/Library/Application Support/synapse on
# macOS, %APPDATA%\synapse on Windows). Set to ":memory:" for a fully
# ephemeral, non-persistent store.
db-path: ""

# v2 control plane (optional). Leave control-plane-url blank -- the default --
# and nothing about the standalone behavior above changes. Set it and the
# process stores memories in the named tenant's Postgres schema instead of the
# local SQLite file, using database-dsn (or the SYNAPSE_DB_DSN environment
# variable, which supplies it when no key is present here). A DSN carries the
# database password: never commit one and never log it.
# control-plane-url: "http://127.0.0.1:9090"
# database-dsn: ""

# v2 sync protocol (optional, Phase 7). These only matter once
# control-plane-url is set above; leave them at their defaults and the
# standalone behavior above is unchanged.

# Secret API key this agent presents to the control plane; seeded from SYNAPSE_PLANE_KEY, never logged, never commit one.
# control-plane-api-key: ""
# Stable identifier for this node; required as soon as control-plane-url is set.
# agent-id: ""
# Optional team this agent's memories belong to; blank means tenant-wide.
# team-id: ""
# Visibility applied to memories this node writes: "org", "team", or "private".
default-visibility: "org"
# How many memories a single sync push carries.
sync-batch-size: 20
# Seconds between sync attempts.
sync-interval-seconds: 30

# OpenAI API key (can also be set via OPENAI_API_KEY environment variable)
openai-api-key: ""

# Weights for the 4-factor scoring model
weight-semantic-similarity: 0.4
weight-recency: 0.1
weight-importance: 0.3
weight-task-alignment: 0.2

# Logging level: debug, info, warn, error
log-level: "info"

# Cosine similarity threshold above which two memories are treated as
# duplicates and one is dropped (0.0-1.0)
deduplication-threshold: 0.92

# Optional: restrict which upstream hosts are allowed (leave unset to allow
# any http(s) URL; localhost/127.x.x.x is always implicitly allowed for
# Ollama). Example: allowed-upstream-hosts: ["api.anthropic.com"]
# allowed-upstream-hosts: []

# Number of candidates pulled from semantic search (by embedding similarity
# across the full memory store) before the 4-factor scorer ranks them down
# to what fits the token budget. Higher values widen recall at the cost of
# more embedding/scoring work per request; lower values are cheaper but can
# miss relevant older memories. Tune this once you have real usage to
# benchmark against -- 50 is a reasonable starting point.
retrieval-candidate-k: 50

# Similarity band (cosine similarity) a new memory must fall within,
# relative to an existing same-type memory in the same session, before
# that existing memory becomes eligible to be marked superseded -- e.g. an
# old "we use PostgreSQL" decision being replaced by a new "we migrated to
# MongoDB" one. This alone is not enough to trigger supersession: the new
# memory's content also has to contain an explicit signal phrase (e.g.
# "instead of", "switched to", "no longer") -- similarity only identifies
# *candidates* for supersession, the phrase gate decides whether it
# actually happens. Kept below deduplication-threshold on purpose: dedup
# already owns near-identical restatements above that line, this band is
# for "same topic, different answer" below it. These are a rough starting
# guess, not a value tuned against real conversations yet.
supersession-similarity-min: 0.5
supersession-similarity-max: 0.90
