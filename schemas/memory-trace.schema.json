{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ranscky/synapse/schemas/memory-trace.schema.json",
  "title": "Synapse Memory Trace",
  "description": "Schema for Synapse Context Compiler memory trace output",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique request identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of trace creation"
    },
    "detected_intent": {
      "type": "string",
      "enum": ["debug", "plan", "code", "write", "generic"],
      "description": "Detected user intent"
    },
    "intent_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence level of intent detection"
    },
    "candidates_retrieved": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of candidate memories retrieved"
    },
    "candidates_after_dedup": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of candidates after deduplication"
    },
    "memories_compiled": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of memories included in final compilation"
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of tokens used in compilation"
    },
    "token_budget": {
      "type": "integer",
      "minimum": 0,
      "description": "Token budget for this compilation"
    },
    "compile_duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Compilation duration in milliseconds"
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Memory entry identifier"
          },
          "memory_type": {
            "type": "string",
            "description": "Type of memory entry"
          },
          "content_preview": {
            "type": "string",
            "maxLength": 100,
            "description": "First 100 characters of memory content"
          },
          "score_semantic": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Semantic similarity score"
          },
          "score_recency": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Recency score"
          },
          "score_importance": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Importance score"
          },
          "score_task_alignment": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Task alignment score"
          },
          "score_total": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Total combined score"
          },
          "included": {
            "type": "boolean",
            "description": "Whether this memory was included in compilation"
          },
          "exclusion_reason": {
            "type": "string",
            "enum": ["deduped", "budget_exceeded", "null"],
            "description": "Reason for exclusion if not included"
          },
          "agent_id": {
            "type": "string",
            "description": "The agent that wrote this memory, echoed from the memory's own backend: the agent_id of the edge that pushed it for a candidate pulled from a control plane, or the local node on a locally written row. Empty when the backend records no agent at all -- the local SQLite store has no agent column, because one file is one agent, so a standalone node's own memories are unattributed. Always present on every entry, included or not: an empty string means unattributed, never another agent."
          },
          "cross_agent": {
            "type": "boolean",
            "description": "True when agent_id names an agent other than the node that assembled this context, i.e. when this memory came from another agent. False when the memory belongs to the compiling node or carries no agent at all -- unattributed is not someone else's, so a standalone node never reports one of its own memories as cross-agent. Always present on every entry, included or not."
          }
        },
        "required": [
          "id",
          "memory_type",
          "content_preview",
          "score_semantic",
          "score_recency",
          "score_importance",
          "score_task_alignment",
          "score_total",
          "included",
          "agent_id",
          "cross_agent"
        ]
      }
    }
  },
  "required": [
    "request_id",
    "timestamp",
    "detected_intent",
    "intent_confidence",
    "candidates_retrieved",
    "candidates_after_dedup",
    "memories_compiled",
    "tokens_used",
    "token_budget",
    "compile_duration_ms",
    "memories"
  ]
}